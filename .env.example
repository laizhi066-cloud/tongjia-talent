# 基础版运行时模板：单实例、单 PocketBase。复制为 .env 后按环境替换敏感值。
# 只放键名与安全默认值；真实密钥只存在于部署环境的运行时配置，不提交到仓库。

POCKETBASE_URL=http://127.0.0.1:8090
NUXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_PUBLIC_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=admin123456
# 本地演示值；部署必须替换为 `openssl rand -hex 32` 生成的独立密钥并长期保存。
ENCRYPTION_KEY=85bde519a92f5227e149b955feab2890d53a5fddac6b15c4f5fa63dd55e69478

HOST=127.0.0.1
PORT=3000
NUXT_APP_BASE_URL=/
# NUXT_PUBLIC_API_BASE_URL=
NUXT_PUBLIC_H5_BASE=http://127.0.0.1:9000

# ── M8 外部接口：M2 基因查询 / M3 基因报告 / M5 培育建议 ──────────────────────
# 源类型默认 mock；只有显式 external 才调用真实供应商。
TALENT_GENE_QUERY_SOURCE=mock
TALENT_GENE_REPORT_SOURCE=mock
TALENT_ADVICE_SOURCE=mock
# TALENT_GENE_QUERY_BASE_URL=
# TALENT_GENE_REPORT_BASE_URL=
# TALENT_ADVICE_BASE_URL=
# TALENT_EXTERNAL_BASE_URL=
# TALENT_EXTERNAL_APP_ID=
# TALENT_EXTERNAL_API_SECRET=
# TALENT_EXTERNAL_API_SECRET_PREVIOUS=
TALENT_EXTERNAL_API_VERSION=v1
# TALENT_EXTERNAL_WEBHOOK_SECRET=
TALENT_EXTERNAL_CLOCK_SKEW_SECONDS=300
TALENT_EXTERNAL_TIMEOUT_MS=15000
TALENT_EXTERNAL_RETRY_MAX=3
TALENT_EXTERNAL_MAX_CONCURRENCY=2
TALENT_EXTERNAL_MAX_QPS=5
TALENT_EXTERNAL_RUN_BUDGET_MS=600000
TALENT_EXTERNAL_BREAKER_THRESHOLD=5
TALENT_EXTERNAL_BREAKER_OPEN_MS=900000
# TALENT_ALERT_WEBHOOK_URL=
TALENT_ALLOW_MOCK_SOURCES=0

# M8 调度与查询超时（M2 查询状态机复用）
TALENT_GENE_REPORT_SYNC_ENABLED=1
TALENT_GENE_REPORT_SYNC_INTERVAL_MS=21600000
TALENT_ADVICE_SYNC_ENABLED=1
TALENT_ADVICE_SYNC_LOOKAHEAD_DAYS=7
TALENT_QUERY_TIMEOUT_HOURS=24
TALENT_QUERY_SWEEP_INTERVAL_MS=600000

# ── M8 PDF 渲染与下载 ─────────────────────────────────────────────────────────
TALENT_PDF_ENABLED=1
TALENT_PDF_STORAGE=auto
# TALENT_PDF_FONT_PATH=
# TALENT_PDF_FONT_BOLD_PATH=
TALENT_PDF_TICKET_TTL_SECONDS=120
TALENT_PDF_TICKET_ONE_TIME=0
# TALENT_PUBLIC_API_BASE_URL=
TALENT_PDF_MAX_CONCURRENCY=2
TALENT_PDF_QUEUE_LIMIT=8
TALENT_PDF_RENDER_TIMEOUT_MS=15000
TALENT_PDF_MAX_BYTES=10485760
TALENT_PDF_WATERMARK_MOBILE=1
TALENT_PDF_DOWNLOAD_LOG_RETENTION_DAYS=180

# 报告 PDF 私有存储
OSS_ENABLED=false
OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com
OSS_REGION=cn-shenzhen
OSS_BUCKET=zhihuitongjia2026
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_PUBLIC_BASE_URL=

# 微信凭据保存在 PocketBase 的 wechat_config，由后台站点配置页面维护。
# 基础版不读取多实例、站点切换或交付档位环境变量。