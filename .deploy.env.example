# 远程部署配置（含服务器凭据；公开仓库绝不提交，私有仓库按组织策略管理）
# 复制为 .deploy.env 后填写；推荐改用 SSH 密钥并删除 DEPLOY_PASSWORD。
DEPLOY_HOST=your-server-ip
DEPLOY_PORT=22
DEPLOY_USER=root
DEPLOY_PASSWORD=change-me-or-use-ssh-key
# 密码为空时使用本机 SSH agent；也可填写私钥绝对路径。
DEPLOY_SSH_KEY=

# 服务器上应用根目录（PB 数据、产物、H5 都在这里）
DEPLOY_PATH=/www/wwwroot/tongjia-talent
# 服务端口（避开服务器已有端口：3002/8091-8095/38080...）
DEPLOY_PB_PORT=8096
DEPLOY_APP_PORT=3101
# 浏览器访问的公开主机（裸 IP 或域名）
DEPLOY_PUBLIC_HOST=your-server-ip
# 当前示例是测试服；生产改为 production，并同时使用 https。
DEPLOY_ENV=staging
# 测试服可用 http；生产必须改为 https，并准备域名证书。
DEPLOY_PUBLIC_SCHEME=http
# nginx 子路径（挂在已有站点下，不改动其它项目）
DEPLOY_H5_BASE=/tongjia-talent-h5
DEPLOY_ADMIN_BASE=/tongjia-talent
DEPLOY_PB_BASE=/tongjia-talent-pb

# 默认不上传数据库；全新生产库使用 --init-db，测试演示库才显式使用 --with-db。
DEPLOY_WITH_DB=false

# PocketBase 与本机构建参数
DEPLOY_PB_VERSION=0.38.1
DEPLOY_PB_ARCH=amd64
DEPLOY_NODE_OPTIONS=--max-old-space-size=4096
DEPLOY_HEALTH_TIMEOUT_SEC=60
DEPLOY_RELEASE_KEEP=3

# 可选：AI 培养计划建议（只注入服务端 PM2，不进入 C 端构建）。
# 建议写入不入库的 .env.production，避免空值覆盖已有生产配置：
# TALENT_AI_BASE_URL=https://api.deepseek.com/anthropic
# TALENT_AI_API_KEY=replace-with-server-secret
# TALENT_AI_MODEL=deepseek-chat
# TALENT_AI_PROTOCOL=anthropic

# 宝塔 nginx 的 extension include 目录（未设置则跳过 nginx 配置）
DEPLOY_NGINX_EXT_DIR=/www/server/panel/vhost/nginx/extension/your-server-ip
