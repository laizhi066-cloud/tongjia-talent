{
  "name": "foundation-portal",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "同佳天赋：H5 与微信小程序双端入口",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "init-baseFiles": "node ./scripts/create-base-files.js",
    "prepare": "npm run init-baseFiles",
    "dev:h5": "node ./scripts/create-base-files.js && uni",
    "dev:mp": "node ./scripts/check-mp-api-env.mjs development && node ./scripts/create-base-files.js && uni -p mp-weixin",
    "build:h5": "node ./scripts/create-base-files.js && uni build",
    "build:mp": "node ./scripts/check-mp-api-env.mjs production && node ./scripts/create-base-files.js && uni build -p mp-weixin",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-4070620250821001",
    "@dcloudio/uni-components": "3.0.0-4070620250821001",
    "@dcloudio/uni-h5": "3.0.0-4070620250821001",
    "@dcloudio/uni-mp-weixin": "3.0.0-4070620250821001",
    "@wot-ui/ui": "2.2.0",
    "dayjs": "^1.11.23",
    "pinia": "2.0.36",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-cli-shared": "3.0.0-4070620250821001",
    "@dcloudio/uni-stacktracey": "3.0.0-4070620250821001",
    "@dcloudio/vite-plugin-uni": "3.0.0-4070620250821001",
    "@types/node": "^20.17.9",
    "@uni-helper/eslint-config": "0.5.0",
    "@uni-helper/plugin-uni": "0.1.0",
    "@uni-helper/uni-types": "1.0.0-alpha.6",
    "@uni-helper/vite-plugin-uni-components": "0.2.3",
    "@uni-helper/vite-plugin-uni-manifest": "0.2.12",
    "@uni-helper/vite-plugin-uni-pages": "0.3.23",
    "eslint": "^9.31.0",
    "eslint-plugin-format": "^1.0.1",
    "miniprogram-api-typings": "^4.1.0",
    "sass": "1.77.8",
    "typescript": "~5.8.0",
    "vite": "5.2.8",
    "vue-tsc": "^3.0.6"
  }
}
