# 变量必须以 VITE_ 为前缀才能暴露给外部读取
NODE_ENV = 'production'
# 是否去除console 和 debugger
VITE_DELETE_CONSOLE = true
# 是否开启sourcemap
VITE_SHOW_SOURCEMAP = false

# production mode H5 后台请求地址：默认与 H5 同源；小程序使用下方按环境区分的完整 URL。
VITE_SERVER_BASEURL = '/'

# 微信开发者工具导入 production 构建时仍处于 develop 环境，必须使用完整地址。
# 真机调试请改为手机可访问的 HTTPS 或局域网地址；体验版 / 正式版在目标构建环境中覆盖对应变量。
VITE_SERVER_BASEURL__WEIXIN_DEVELOP = 'http://127.0.0.1:3000'
# VITE_SERVER_BASEURL__WEIXIN_TRIAL = 'https://trial.example.com'
# VITE_SERVER_BASEURL__WEIXIN_RELEASE = 'https://api.example.com'

# H5 默认部署在站点根路径；如需子路径部署，例如 /portal/，请使用以 / 开头和结尾的路径。
VITE_APP_PUBLIC_BASE=/
