# 变量必须以 VITE_ 为前缀才能暴露给外部读取
NODE_ENV = 'development'
# 是否去除console 和 debugger
VITE_DELETE_CONSOLE = false
# 是否开启sourcemap
VITE_SHOW_SOURCEMAP = false

# development mode 后台请求地址
# 用 127.0.0.1 而非 localhost：Node 17+ 会把 localhost 解析为 ::1，
# 而 nuxt dev 的 IPv6 端口挂的是 HMR websocket（返回 426）
VITE_SERVER_BASEURL = 'http://127.0.0.1:3000'
# 微信开发者工具使用完整地址；真机调试时替换为手机可访问的 HTTPS 地址或局域网地址。
VITE_SERVER_BASEURL__WEIXIN_DEVELOP = 'http://127.0.0.1:3000'

# h5 开发代理，解决跨域
VITE_APP_PROXY_ENABLE = true
